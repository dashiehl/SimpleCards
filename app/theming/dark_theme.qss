QWidget {
    background-color: #12141a;
    color: #f2f3f7;
}

/* Labels inherit their container's surface instead of painting their own band */
QLabel { background: transparent; }
QCheckBox, QRadioButton { background: transparent; spacing: 8px; }
QScrollArea > QWidget > QWidget { background: transparent; }

QMainWindow {
    background-color: #12141a;
}

#SideNav {
    background-color: #161922;
    border-right: 1px solid #2f3444;
}

QPushButton#NavButton {
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #9aa0b4;
    font-size: 14px;
}
QPushButton#NavButton:hover {
    background-color: #242836;
    color: #f2f3f7;
}
QPushButton#NavButton:checked {
    background-color: #242836;
    color: #f2f3f7;
    font-weight: 600;
}

QLabel#AppTitle {
    color: #f2f3f7;
    font-size: 24px;
    font-weight: 800;
    padding: 4px 8px;
}
QLabel#Subtitle {
    color: #9aa0b4;
    font-size: 13px;
}
QLabel#SectionTitle {
    color: #9aa0b4;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QFrame#Card {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1f2230, stop:1 #191c25);
    border: 1px solid #3a3560;
    border-radius: 20px;
}

QFrame#DeckCard {
    background-color: #1b1e27;
    border: 1px solid #2f3444;
    border-radius: 14px;
}
QFrame#DeckCard:hover {
    border: 1px solid #7c6cf0;
}

QLabel#CardFront {
    color: #f2f3f7;
    font-size: 28px;
    font-weight: 600;
}
QLabel#CardForms {
    color: #7c6cf0;
    font-size: 14px;
    font-style: italic;
}
QLabel#CardBack {
    color: #f2f3f7;
    font-size: 18px;
}
QLabel#CardExample {
    color: #9aa0b4;
    font-size: 15px;
    font-style: italic;
}
QLabel#FlipHint {
    color: #666c82;
    font-size: 12px;
}
QLabel#FieldCaption {
    color: #666c82;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-top: 6px;
}
QLabel#LeechBadge {
    background-color: #e5566d;
    color: #ffffff;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 700;
}
QLabel#TagChip {
    background-color: #242836;
    color: #9aa0b4;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
}

QLabel#DeckName {
    color: #f2f3f7;
    font-size: 16px;
    font-weight: 600;
}
QLabel#DeckMeta {
    color: #9aa0b4;
    font-size: 12px;
}

QPushButton {
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    border: none;
}
QPushButton:disabled {
    background-color: #1b1e27;
    color: #666c82;
    border: 1px solid #2f3444;
}

QPushButton#Primary {
    background-color: #7c6cf0;
    color: #ffffff;
}
QPushButton#Primary:hover { background-color: #8f80f5; }
QPushButton#Primary:pressed { background-color: #6a5adf; }

QPushButton#GradeAgain { background-color: #e5566d; color: #ffffff; }
QPushButton#GradeAgain:hover { background-color: #ea7086; }
QPushButton#GradeHard { background-color: #e6a23c; color: #1b1e27; }
QPushButton#GradeHard:hover { background-color: #ecb75e; }
QPushButton#GradeGood { background-color: #3ec98a; color: #1b1e27; }
QPushButton#GradeGood:hover { background-color: #5cd6a0; }
QPushButton#GradeEasy { background-color: #3fb6de; color: #1b1e27; }
QPushButton#GradeEasy:hover { background-color: #63c5e6; }
QPushButton#GradeAgain:disabled, QPushButton#GradeHard:disabled,
QPushButton#GradeGood:disabled, QPushButton#GradeEasy:disabled {
    background-color: #1b1e27;
    color: #666c82;
    border: 1px solid #2f3444;
}

QPushButton#Secondary {
    background-color: #242836;
    color: #f2f3f7;
    border: 1px solid #2f3444;
}
QPushButton#Secondary:hover { background-color: #2c3140; }

QPushButton#Destructive {
    background-color: transparent;
    color: #e5566d;
    border: 1px solid #e5566d;
}
QPushButton#Destructive:hover { background-color: #e5566d; color: #ffffff; }

QPushButton#TableAction {
    background-color: #242836;
    color: #f2f3f7;
    border: 1px solid #2f3444;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 6px;
}
QPushButton#TableAction:hover { background-color: #2c3140; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1b1e27;
    border: 1px solid #2f3444;
    border-radius: 8px;
    padding: 8px;
    color: #f2f3f7;
    selection-background-color: #7c6cf0;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #7c6cf0;
}

QScrollArea { border: none; }
QScrollBar:vertical {
    background: transparent;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #2f3444;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QLabel#DueBadge {
    border: 1px solid #7c6cf0;
    background-color: #7c6cf0;
    color: #ffffff;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 700;
}
QLabel#DueBadgeEmpty {
    border: 1px solid #242836;
    background-color: #242836;
    color: #666c82;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 700;
}

QFrame#ModeTile {
    min-height: 170px;
    background-color: #1b1e27;
    border: 1px solid #2f3444;
    border-radius: 14px;
}
QFrame#ModeTile:hover {
    border: 1px solid #7c6cf0;
}
QLabel#ModeTileDescription {
    color: #9aa0b4;
    font-size: 13px;
}
QLabel#ModeIcon {
    background-color: #2a2550;
    color: #b3a8ff;
    border-radius: 12px;
    font-size: 20px;
    font-weight: 800;
    min-width: 44px; max-width: 44px;
    min-height: 44px; max-height: 44px;
    qproperty-alignment: AlignCenter;
}
QLabel#StatValue {
    color: #f2f3f7;
    font-size: 30px;
    font-weight: 800;
}
QPushButton#Ghost {
    background-color: transparent;
    color: #9aa0b4;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 6px;
}
QPushButton#Ghost:hover { background-color: #242836; color: #f2f3f7; }

QProgressBar {
    background-color: #242836;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7c6cf0, stop:1 #3fb6de);
    border-radius: 3px;
}

QComboBox, QSpinBox {
    background-color: #1b1e27;
    border: 1px solid #2f3444;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 20px;
}
QComboBox:hover, QSpinBox:hover { border: 1px solid #7c6cf0; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #1b1e27;
    border: 1px solid #2f3444;
    selection-background-color: #7c6cf0;
    outline: none;
}

QTableWidget, QTableView {
    background-color: #1b1e27;
    alternate-background-color: #1e2230;
    border: 1px solid #2f3444;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: #2a2550;
}
QTableWidget::item, QTableView::item { padding: 6px; }
QHeaderView::section {
    background-color: #161922;
    color: #9aa0b4;
    border: none;
    border-bottom: 1px solid #2f3444;
    padding: 8px;
    font-size: 11px;
    font-weight: 700;
}
QTableCornerButton::section { background-color: #161922; border: none; }

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid #3a3f52;
    background-color: #1b1e27;
    border-radius: 4px;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #7c6cf0;
    border: 1px solid #7c6cf0;
}
QToolTip {
    background-color: #242836;
    color: #f2f3f7;
    border: 1px solid #2f3444;
    padding: 6px;
}

QPushButton#MatchTile {
    background-color: #1b1e27;
    color: #f2f3f7;
    border: 1px solid #2f3444;
    border-radius: 10px;
    padding: 14px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#MatchTile:hover {
    border: 1px solid #7c6cf0;
}
QPushButton#MatchTile[matchState="selected"] {
    border: 2px solid #7c6cf0;
    background-color: #242836;
}
QPushButton#MatchTile[matchState="matched"] {
    background-color: #1b2a22;
    border: 2px solid #3ec98a;
    color: #3ec98a;
}
QPushButton#MatchTile[matchState="wrong"] {
    background-color: #2a1b1f;
    border: 2px solid #e5566d;
    color: #e5566d;
}

QGroupBox {
    border: 1px solid #2f3444;
    border-radius: 10px;
    margin-top: 10px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
    color: #9aa0b4;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #f2f3f7;
}
